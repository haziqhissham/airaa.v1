# ─────────────────────────────────────────────────────────────
# Supabase (v2) — Auth, Postgres, Storage, RLS
# ─────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=            # server only — bypasses RLS

# Prisma connection strings (from Supabase → Project Settings → Database)
DATABASE_URL=                          # pooled (PgBouncer, ?pgbouncer=true)
DIRECT_URL=                            # direct connection (for migrations)

# OAuth (optional; enable providers in Supabase dashboard)
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_SECRET=
AZURE_OAUTH_CLIENT_ID=
AZURE_OAUTH_SECRET=

# ─────────────────────────────────────────────────────────────
# AI providers (Step 8) — at least one required for AI reports
# ─────────────────────────────────────────────────────────────
AI_DEFAULT_PROVIDER=claude             # claude | openai | gemini
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_AI_API_KEY=

# ─────────────────────────────────────────────────────────────
# App configuration (tenant-neutral / white-label defaults)
# ─────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_NAME="AI Readiness Assessment"
NEXT_PUBLIC_DEFAULT_ORG_NAME="Your Organisation"
NEXT_PUBLIC_DEFAULT_ORG_SLUG="default"
